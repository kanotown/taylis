{
	# Secrets in URL paths (docs/DRIVE.md §9.5, SECURITY.md §7): share links, invites, iCal feeds, webhooks, the drive's
	# download and ZIP tickets. This site writes no access log, but Caddy's default logger still writes an error line
	# (logger http.log.error) with the whole request.uri whenever reverse_proxy fails (the app down or restarting:
	# 502), and any `log` added later goes through the default logger too. Mask them before anything is written, the
	# same paths as app/core/logging.py and the nginx example's map (REVIEW-v0.1.70 #4). The query string is kept:
	# none of these secrets travel in it. The Referer of a request from such a page is masked the same way.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp "^(/s/|/invite/|/api/v1/(?:shares|invites|calendar/ical|hooks|drive/download|drive/zip)/)[^/?]+" "${1}***"
				request>headers>Referer regexp "(/s/|/invite/|/api/v1/(?:shares|invites|calendar/ical|hooks|drive/download|drive/zip)/)[^/?]+" "${1}***"
			}
		}
	}
	servers {
		# Whose X-Forwarded-For / X-Forwarded-Proto are passed on to the app (the client address it records and
		# rate-limits, https for the Secure cookie). Only this container by default: a client cannot set them.
		# docker-compose.behind-proxy.yml sets private_ranges for the host's nginx in front.
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$CHAT_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Content-Type-Options nosniff

	# LiveKit's webhook (M130, docs/CALLS.md §7.4) comes from inside the compose network only (http://app:8000);
	# from outside it does not exist. The app checks its signature anyway.
	handle /api/v1/livekit/* {
		respond 404
	}

	@uploads path /api/v1/attachments*
	handle @uploads {
		request_body {
			max_size 110MB
		}
		reverse_proxy app:8000
	}

	# Profile pictures and the workspace icon (M93): the app takes up to 5 MB (AVATAR_MAX_BYTES). The clients crop and
	# shrink profile pictures first, but an older client may still send a whole photo, and the icon is sent as picked;
	# the 1 MB below cut a 1 MB logo off mid-body (the app answered 400, the Mac app showed a connection error, 2026-10-04).
	@avatar path /api/v1/users/me/avatar /api/v1/admin/workspace-settings/icon
	handle @avatar {
		request_body {
			max_size 6MB
		}
		reverse_proxy app:8000
	}

	# Emoji pack import (M100): a ZIP, or a folder's files, of up to 64 MiB (PACK_UPLOAD_MAX_BYTES), plus the multipart
	# overhead. The 1 MB below refused any real pack with 413 (Review v0.1.37 #8). Admins only; the app checks every file.
	@emojipack path /api/v1/emoji/packs/import
	handle @emojipack {
		request_body {
			max_size 70MB
		}
		reverse_proxy app:8000
	}

	# The drive's resumable uploads (M160, docs/DRIVE.md §6, §9.6): one part of 16 MiB (DRIVE_PART_BYTES) per request,
	# the body checked by the app (size and SHA-256). Everything else of the drive is JSON under the 1 MB below.
	@driveparts path_regexp ^/api/v1/drive/uploads/[^/]+/parts/[0-9]+$
	handle @driveparts {
		request_body {
			max_size 17MB
		}
		reverse_proxy app:8000
	}

	# The drive's external share links (M163, docs/DRIVE.md §9.3, §9.6). The token is in the path: this Caddyfile has
	# no `log` directive, so Caddy writes no access log, but its error log names the request when the app cannot be
	# reached: the global `log default` above masks the token there (and in an access log, should one be added);
	# the app masks it in its own log. The public API: the app sets noindex, no-referrer, nosniff, no framing and
	# no-store on every answer, its errors too (app/modules/drive/public.py), so they are not repeated here.
	@shareapi path /api/v1/shares/*
	handle @shareapi {
		request_body {
			max_size 1MB
		}
		reverse_proxy app:8000
	}

	# The public page /s/<token>: the web bundle's second entry (share.html), never cached, indexed, framed or referred.
	@sharepage path /s/*
	handle @sharepage {
		root * /srv/web
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		header Referrer-Policy no-referrer
		header X-Frame-Options DENY
		header X-Robots-Tag "noindex, nofollow, noarchive"
		header Cache-Control no-store
		rewrite * /share.html
		file_server
	}

	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy app:8000
	}

	handle /healthz {
		reverse_proxy app:8000
	}

	# M104: the public account deletion page (the store listings' "delete account URL"), served by the app.
	handle /account-deletion {
		reverse_proxy app:8000
	}

	# The browser client (M12j): the same bundle as the desktop app, built into this image
	# (infra/web.Dockerfile). Unknown paths (including /m/<id> and /invite/<token>) load the app,
	# which reads the path itself. Hashed assets are immutable; index.html must be revalidated.
	handle {
		root * /srv/web
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' blob:; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		header Referrer-Policy no-referrer
		header X-Frame-Options DENY
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
