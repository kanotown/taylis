# infra/.env for the demo server (infra/demo/DEPLOY_VPS.md). Copy to infra/.env (mode 600) and fill in the
# three random values; never commit the filled file.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=production
# seed-demo --reset refuses unless the workspace has this name (demo-vps.sh checks it too)
WORKSPACE_NAME=Taylis デモ研究室

SECRET_KEY=
POSTGRES_USER=chikuwa
POSTGRES_PASSWORD=
POSTGRES_DB=chikuwa
S3_ACCESS_KEY=chikuwa
S3_SECRET_KEY=
S3_BUCKET=chikuwa
S3_REGION=us-east-1

# The public name; the host's nginx terminates TLS and proxies to Caddy on 127.0.0.1:BEHIND_PROXY_PORT.
# The production instance on the same host already uses 18080.
CHAT_DOMAIN=demo.example.com
BEHIND_PROXY_PORT=18081
PUBLIC_BASE_URL=https://demo.example.com

LOG_LEVEL=INFO
PASSWORD_MIN_LENGTH=8

# No push notifications and no AI on the demo (no keys are mounted; demo-vps.sh leaves empty files).
PUSH_APNS_ENABLED=false
PUSH_FCM_ENABLED=false

# Document previews stay on (the converter service, http://converter:3000 by default).
ATTACHMENT_MAX_BYTES=104857600
# Small server: fewer database connections than the default 20 + 10.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
