# infra/.env.example
# infra/.env にコピーして値を埋める。infra/.env はコミットされない (.gitignore)。
# 秘密の実値をこのファイルに書かないこと。

# development | production
ENVIRONMENT=production

# クライアントのワークスペース切り替えに表示する名前 (docs/WORKSPACES.md)。空なら Taylis
WORKSPACE_NAME=

# 32 文字以上のランダム値。生成: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

POSTGRES_USER=chikuwa
POSTGRES_PASSWORD=
POSTGRES_DB=chikuwa
# 開発時にホストへ公開するポート (本番は docker-compose.prod.yml で公開しない)
POSTGRES_HOST_PORT=5432
APP_HOST_PORT=8000
# 実機から LAN 経由で接続するときだけ 0.0.0.0 にする (既定は localhost のみ)
APP_BIND=127.0.0.1

# オブジェクトストレージ (versitygw)
S3_ACCESS_KEY=chikuwa
S3_SECRET_KEY=
S3_BUCKET=chikuwa
S3_REGION=us-east-1

# caddy プロファイルを使う場合のドメイン
CHAT_DOMAIN=chat.example.com
# 既存の nginx の後ろで動かすとき (docker-compose.behind-proxy.yml)、Caddy が受ける 127.0.0.1 のポート
#BEHIND_PROXY_PORT=18080

LOG_LEVEL=INFO
# パスワードの最小文字数 (既定 8)
PASSWORD_MIN_LENGTH=8
# CORS を許可するオリジン (Desktop の WebView と開発サーバ)。Web クライアントを置く場合はここに追加
CORS_ALLOW_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420,http://localhost:1421

# --- APNs (M5) --- 鍵は infra/secrets/ に置き、compose が /run/secrets/apns_key.p8 にマウントする
APNS_KEY_FILE=./secrets/AuthKey_XXXXXXXXXX.p8
PUSH_APNS_ENABLED=false
PUSH_APNS_KEY_PATH=/run/secrets/apns_key.p8
PUSH_APNS_KEY_ID=
PUSH_APNS_TEAM_ID=
PUSH_APNS_BUNDLE_ID=

# --- FCM (M7) --- Firebase のサービスアカウント鍵 (JSON) を infra/secrets/ に置き、compose がマウントする
FCM_SERVICE_ACCOUNT_FILE=./secrets/fcm_service_account.json
PUSH_FCM_ENABLED=false
PUSH_FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm_service_account.json

# --- AI (M65、docs/AI.md) --- API キーは infra/secrets/anthropic_api_key に 1 行で置き、compose が /run/secrets にマウントする
# (無ければ AI は使えないと表示されるだけ)。予算は月 (UTC) ごと、回数は人ごとの直近 24 時間 (メンションと要約の合計)
#ANTHROPIC_API_KEY_FILE=./secrets/anthropic_api_key
#AI_API_KEY_FILE=/run/secrets/anthropic_api_key
# OpenAI のモデル (gpt-6.1-sol / gpt-6-luna) のボットを使うときは infra/secrets/openai_api_key に 1 行で置く (docs/AI.md §12)
#OPENAI_API_KEY_FILE=./secrets/openai_api_key
#AI_OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
#AI_MONTHLY_BUDGET_USD=30
#AI_USER_DAILY_RUNS=50

# --- 添付 (M9a) --- 既定は 100 MB。Caddyfile の request_body max_size と揃える
ATTACHMENT_MAX_BYTES=104857600
ATTACHMENT_PENDING_TTL_HOURS=24

# --- 文書のプレビュー (M108、docs/PREVIEWS.md) --- compose の converter (Gotenberg) が Office ファイルを PDF にする。
# 既定 (未設定) は http://converter:3000。空にすると Office のプレビューを作らない (PDF の 1 ページ目と頁数は作る)
#PREVIEW_CONVERTER_URL=
# false にするとプレビューを一切作らない
#PREVIEWS_ENABLED=true
# これより大きいファイルはプレビューを作らない (既定 50 MB。converter の --api-body-limit=55MB の内側)
#PREVIEW_MAX_INPUT_BYTES=52428800

# --- Google でログイン (M48、docs/SSO.md §2) --- 4 つ (ID・secret・ドメイン・PUBLIC_BASE_URL) がそろったときだけ有効
# client secret はファイルで渡す: infra/secrets/google_client_secret に置き、compose が /run/secrets にマウントする
#GOOGLE_CLIENT_SECRET_FILE=./secrets/google_client_secret
#SSO_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google_client_secret
#SSO_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# 受け付ける Workspace のドメイン (カンマ区切り)。空なら SSO は無効
#SSO_GOOGLE_ALLOWED_DOMAINS=example.ac.jp
# ログインのボタンに出す組織の名前 (「<名前> のアカウントでログイン」)。空ならドメイン
#SSO_GOOGLE_LABEL=
# true: そのドメインの人は初回ログインで一般メンバーとして作られる (案B)。既定 false
#SSO_AUTO_PROVISION=false
# 非推奨 (M90): 自動で作った人が入る公開チャンネルの名前 (カンマ区切り)。管理 → 設定 →「既定のチャンネル」を
# 一度でも保存すると、そちらが優先されこの値は使われない (docs/MEMBERSHIP.md §6)
#SSO_DEFAULT_CHANNELS=general
# このサーバの公開 URL (callback と Web への戻り先)
#PUBLIC_BASE_URL=https://chat.example.com
