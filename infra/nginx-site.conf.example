# ChikuwaChat behind the host's nginx (infra/README.md 「既存の nginx の後ろで動かす」): nginx terminates TLS,
# Caddy (docker-compose.behind-proxy.yml) serves the web client and the API on 127.0.0.1:18080.
# Replace chat.example.com, then as root:
#   cp nginx-site.conf.example /etc/nginx/sites-available/chikuwachat
#   ln -s /etc/nginx/sites-available/chikuwachat /etc/nginx/sites-enabled/ && nginx -t && systemctl reload nginx
#   certbot --nginx -d chat.example.com --redirect     # adds the 443 listener with the certificate

map $http_upgrade $chikuwachat_connection {
    default upgrade;
    ''      close;
}

# Paths whose next part is a secret (docs/SECURITY.md §7, docs/DRIVE.md §9.5): the drive's external share links
# (/s/<token>, /api/v1/shares/<token>/…), invite links, iCal feeds, webhooks, the drive's download and ZIP tickets.
# nginx's default access log would keep them in /var/log/nginx for weeks: this one writes them as ***.
# (The query string is left out on purpose too.) error_log cannot be masked: on an upstream error (Caddy down, a
# timeout) it writes the request line, the upstream URL and the referrer as they are. Keep /var/log/nginx readable by
# root / adm only, or set the error_log line in the server block below to crit (infra/README.md, REVIEW-v0.1.70 #4).
map $uri $chikuwachat_log_uri {
    ~^(?<chikuwachat_p>/s/|/invite/|/api/v1/(shares|invites|calendar/ical|hooks|drive/download|drive/zip)/)[^/]+(?<chikuwachat_rest>.*)$ $chikuwachat_p***$chikuwachat_rest;
    default $uri;
}
log_format chikuwachat_masked '$remote_addr - $remote_user [$time_local] "$request_method $chikuwachat_log_uri $server_protocol" '
                              '$status $body_bytes_sent "-" "$http_user_agent"';

server {
    listen 80;
    server_name chat.example.com;

    # Attachments up to 100 MB (ATTACHMENT_MAX_BYTES); Caddy applies the exact limit per path
    # (emoji pack imports 70 MB, profile pictures 6 MB, the rest of /api/* 1 MB).
    client_max_body_size 110m;

    # The masked access log above instead of the default one (which would keep share-link tokens). The certbot step
    # leaves this line in place.
    access_log /var/log/nginx/access.log chikuwachat_masked;
    # Optional: upstream errors are logged at the `error` level with the token in the request line; at `crit` they are
    # not written at all (the masked access log still has the 502). Uncomment to keep share tokens out of error_log.
    # error_log /var/log/nginx/chikuwachat-error.log crit;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Replace, never append: a client must not choose the address the app records and rate-limits.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket (/api/v1/ws) stays open for hours.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $chikuwachat_connection;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        # Stream uploads and downloads instead of spooling them to disk.
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
