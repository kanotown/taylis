<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The server URL is user-provided; self-hosted deployments on a LAN may use plain HTTP.
       Production deployments are expected to sit behind TLS (Caddy). -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
    <key>NSAllowsArbitraryLoadsInWebContent</key>
    <true/>
  </dict>
  <!-- Message notifications are donated as INSendMessageIntent to become communication notifications (the sender's
       picture, docs/PUSH_NOTIFICATIONS.md §9.1; needs the entitlement, communication.entitlements). -->
  <key>NSUserActivityTypes</key>
  <array>
    <string>INSendMessageIntent</string>
  </array>
</dict>
</plist>
