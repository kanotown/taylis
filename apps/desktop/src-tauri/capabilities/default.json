{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: dragging the window by its top bar (macOS overlay title bar; on Windows our top bar is the whole title bar, with its own minimise / maximise / close buttons),local SQLite store, OS notifications, the unread badge, external links in the system browser, the text size (webview zoom), saving a download into the Downloads folder under a free name (or where the user picked in the save dialog), showing a saved download in Finder / Explorer and opening one saved in Downloads in its app (never a program or script: those are denied here and in platform/download.ts), the credential-store commands, the `chikuwachat://` link that launched the app (Google sign-in), and in-app updates (check, download and install, then relaunch).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-badge-count",
    "core:webview:allow-set-webview-zoom",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "notification:default",
    "dialog:default",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:scope-download-recursive",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        }
      ],
      "deny": [
        {
          "path": "$DOWNLOAD/**/*.exe"
        },
        {
          "path": "$DOWNLOAD/**/*.msi"
        },
        {
          "path": "$DOWNLOAD/**/*.bat"
        },
        {
          "path": "$DOWNLOAD/**/*.cmd"
        },
        {
          "path": "$DOWNLOAD/**/*.com"
        },
        {
          "path": "$DOWNLOAD/**/*.scr"
        },
        {
          "path": "$DOWNLOAD/**/*.ps1"
        },
        {
          "path": "$DOWNLOAD/**/*.vbs"
        },
        {
          "path": "$DOWNLOAD/**/*.js"
        },
        {
          "path": "$DOWNLOAD/**/*.jar"
        },
        {
          "path": "$DOWNLOAD/**/*.lnk"
        },
        {
          "path": "$DOWNLOAD/**/*.app"
        },
        {
          "path": "$DOWNLOAD/**/*.command"
        },
        {
          "path": "$DOWNLOAD/**/*.sh"
        },
        {
          "path": "$DOWNLOAD/**/*.pkg"
        },
        {
          "path": "$DOWNLOAD/**/*.dmg"
        }
      ]
    },
    "deep-link:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    }
  ]
}
