{
  "name": "chikuwachat-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../../openapi/openapi.json -o src/api/schema.d.ts",
    "tauri": "tauri",
    "tauri:build": "tauri build --config src-tauri/tauri.no-updater.conf.json",
    "dev:2": "vite --port 1421",
    "tauri:dev:2": "tauri dev --config src-tauri/tauri.dev2.conf.json"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "~2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "~2.5.5",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-sql": "^2",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9",
    "vite": "^8",
    "vitest": "^5"
  }
}
