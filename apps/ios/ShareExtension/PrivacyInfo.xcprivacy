<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Share Extension's privacy manifest (MOBILE_UI.md §21, docs/STORE_RELEASE.md). It sends what the person shares
  only to the workspace server they chose (self-hosted); the data types are declared in the app's manifest.
  Required-reason APIs: only UserDefaults, the App Group's defaults shared with the app (1C8F.1: the workspace list,
  recent conversations, attachment limits and UI language). File sizes only (fileSizeKey), no timestamps.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
</dict>
</plist>
