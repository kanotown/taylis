<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- SYNC_PROTOCOL.md §5.3: reconnect as soon as the network comes back instead of after the backoff. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- MOBILE_UI.md §20.4: a shared file keeps uploading after the share screen closed (WorkManager's foreground job). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- usesCleartextTraffic: self-hosted servers on a LAN may not have TLS yet (same as the iOS ATS
         setting). Production deployments terminate TLS at Caddy (SECURITY.md). -->
    <application
        android:name=".ChikuwaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChikuwaChat"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- M48 (docs/SSO.md §6): Google sign-in returns here from the browser. singleTask: the return brings this
                 activity back (onNewIntent) and closes the Custom Tab above it instead of stacking a second copy. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="chikuwachat" android:host="sso" />
            </intent-filter>
            <!-- MOBILE_UI.md §20.5: Direct Share (the conversation shortcuts as share targets of ShareActivity). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- MOBILE_UI.md §20: other apps' share sheets (files, pictures, videos, PDFs, text and links). -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- MOBILE_UI.md §20.4: ShareWorker's foreground job (uploads) runs in WorkManager's service; Android 14 needs its type. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- The 在室状況 home-screen widget (Jetpack Glance). Its buttons run in this app (widget/AttendanceWidgetWorker). -->
        <receiver
            android:name=".widget.AttendanceWidgetReceiver"
            android:exported="true"
            android:label="@string/attendance_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/attendance_widget_info" />
        </receiver>

        <!-- 未読・メンション (widget/UnreadWidget.kt): the app writes its snapshot; a row opens its conversation. -->
        <receiver
            android:name=".widget.UnreadWidgetReceiver"
            android:exported="true"
            android:label="@string/unread_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/unread_widget_info" />
        </receiver>

        <!-- 今日の予定・締切 (widget/TodayWidget.kt): read and redrawn by widget/TodayWidgetWorker in this app. -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/today_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <service
            android:name=".platform.ChikuwaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
