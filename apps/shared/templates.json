{
  "_comment": "M30 (DATA_MODEL.md message_templates): what a template's placeholders become and what /日程 makes, for the three clients. `today` is the device's local date. expand: the body inserted into the input. schedule: `args` after /日程 → the poll's question and options, or error (the command is refused, nothing is posted). weekdays: the options /日程 alone offers (the next 5 weekdays after today).",
  "expand": [
    {
      "name": "the three placeholders",
      "today": "2026-09-28",
      "input": "**日報 {date}**\n曜日: {weekday}\n週: {week}",
      "output": "**日報 2026/09/28 (月)**\n曜日: 月\n週: 2026-W40"
    },
    {
      "name": "zero-padded date, Sunday",
      "today": "2026-01-04",
      "input": "{date} {weekday}",
      "output": "2026/01/04 (日) 日"
    },
    {
      "name": "ISO week 53 at the end of the year",
      "today": "2026-12-31",
      "input": "{week}",
      "output": "2026-W53"
    },
    {
      "name": "the ISO week of 1 January belongs to the year before",
      "today": "2027-01-01",
      "input": "{date} {week}",
      "output": "2027/01/01 (金) 2026-W53"
    },
    {
      "name": "ISO week 1 starts in December",
      "today": "2025-12-29",
      "input": "{week}",
      "output": "2026-W01"
    },
    {
      "name": "repeated placeholders",
      "today": "2026-09-29",
      "input": "{date}〜{date} ({weekday}/{weekday})",
      "output": "2026/09/29 (火)〜2026/09/29 (火) (火/火)"
    },
    {
      "name": "unknown or other-case placeholders stay",
      "today": "2026-09-29",
      "input": "{Date} {time} {name} {{date}} {week",
      "output": "{Date} {time} {name} {2026/09/29 (火)} {week"
    },
    {
      "name": "no placeholder",
      "today": "2026-09-29",
      "input": "今日やったこと\n- ",
      "output": "今日やったこと\n- "
    }
  ],
