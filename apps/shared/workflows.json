{
  "_comment": "Workflow forms (docs/WORKFLOWS.md §3): how a template is rendered, which values are accepted and what the form starts with. The server (server/app/modules/workflows/render.py; it does not fill defaults) and every client's preview and form checks follow these cases.",
  "render": [
    {
      "name": "absence report: a user mention, a Japanese date, the reason line",
      "fields": [
        {
          "key": "報告者",
          "label": "報告者",
          "type": "user",
          "required": true
        },
        {
          "key": "日付",
          "label": "日付",
          "type": "date",
          "required": true
        },
        {
          "key": "内容",
          "label": "報告の内容",
          "type": "select",
          "required": true,
          "options": [
            "欠席",
            "遅刻",
            "早退"
          ]
        },
        {
          "key": "理由",
          "label": "理由",
          "type": "textarea"
        }
      ],
      "template": "*【報告者】* {{報告者}}\n*【報告の内容】* ゼミの{{内容}}\n*【日付】* {{日付}}\n*【理由】* {{理由}}",
      "values": {
        "報告者": [
          "0190a1b2-0000-7000-8000-000000000001"
        ],
        "日付": "2026-07-28",
        "内容": "欠席",
        "理由": "体調不良のため"
      },
      "expected": "*【報告者】* <@0190a1b2-0000-7000-8000-000000000001>\n*【報告の内容】* ゼミの欠席\n*【日付】* 2026年7月28日 (火)\n*【理由】* 体調不良のため"
    },
    {
      "name": "an empty optional field drops its whole line",
      "fields": [
        {
          "key": "報告者",
          "label": "報告者",
          "type": "user",
          "required": true
        },
        {
          "key": "日付",
          "label": "日付",
          "type": "date",
          "required": true
        },
        {
          "key": "内容",
          "label": "報告の内容",
          "type": "select",
          "required": true,
          "options": [
            "欠席",
            "遅刻",
            "早退"
          ]
        },
        {
          "key": "理由",
          "label": "理由",
          "type": "textarea"
        }
      ],
      "template": "*【報告者】* {{報告者}}\n*【報告の内容】* ゼミの{{内容}}\n*【日付】* {{日付}}\n*【理由】* {{理由}}",
      "values": {
        "報告者": [
          "0190a1b2-0000-7000-8000-000000000001"
        ],
        "日付": "2026-07-28",
        "内容": "遅刻",
        "理由": ""
      },
      "expected": "*【報告者】* <@0190a1b2-0000-7000-8000-000000000001>\n*【報告の内容】* ゼミの遅刻\n*【日付】* 2026年7月28日 (火)"
    },
    {
      "name": "seminar notice: @channel from the template, a datetime, several people",
      "fields": [
        {
          "key": "回",
          "label": "回",
          "type": "text",
          "required": true
        },
        {
          "key": "日時",
          "label": "日時",
          "type": "datetime",
          "required": true
        },
        {
          "key": "場所",
          "label": "場所/URL",
          "type": "text"
        },
        {
          "key": "発表者",
          "label": "発表者",
          "type": "user",
          "multiple": true
        }
      ],
      "template": "<!channel> *【第 {{回}} 回学部ゼミのお知らせ】*\n• *日時*：{{日時}}\n• *場所*：{{場所}}\n• *発表者*：{{発表者}}",
      "values": {
        "回": "6",
        "日時": "2026-05-19T13:00",
        "場所": "W2-101",
        "発表者": [
          "0190a1b2-0000-7000-8000-000000000001",
          "0190a1b2-0000-7000-8000-000000000002"
        ]
      },
      "expected": "<!channel> *【第 6 回学部ゼミのお知らせ】*\n• *日時*：2026年5月19日 (火) 13:00\n• *場所*：W2-101\n• *発表者*：<@0190a1b2-0000-7000-8000-000000000001> <@0190a1b2-0000-7000-8000-000000000002>"
    },
