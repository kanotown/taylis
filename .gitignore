# secrets / local config
.env
.env.*
!.env.example
*.p8
*service-account*.json

# preset emoji art (docs/EMOJI.md §8): copied to the server, never committed
infra/emoji-presets/

# python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# node / tauri
node_modules/
dist/
apps/desktop/src-tauri/target/

# ios
apps/ios/**/xcuserdata/
apps/ios/**/DerivedData/
apps/ios/**/*.xcuserstate
apps/ios/**/Pods/

# android
apps/android/**/build/
apps/android/**/.gradle/
apps/android/**/.kotlin/
apps/android/**/local.properties
apps/android/**/*.keystore
apps/android/app/google-services.json

# os / editors
.DS_Store
.idea/
.vscode/
*.swp

# secrets directory: nothing inside is ever committed (except its README)
infra/secrets/*
!infra/secrets/README.md

# server local env
server/.env

# production server state written by infra/deploy.sh / the administrator (never committed)
infra/deploy.conf
infra/.release
infra/.release.previous
infra/releases/
# backups contain every message: they never go into git (infra/backup.sh default location)
infra/backups/
